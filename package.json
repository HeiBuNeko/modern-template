    ]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modern-js/runtime": "3.7.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@modern-js/app-tools": "3.7.0",
    "@modern-js/tsconfig": "3.7.0",
    "@biomejs/biome": "1.9.4",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "~5.7.3",
    "@types/node": "^20",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6"
  }
